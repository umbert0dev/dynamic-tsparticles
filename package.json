{
  "name": "dynamic-tsparticles",
  "version": "0.1.0",
  "description": "tsParticles with dynamic speed (slider/audio): adapters per framework — use `dynamic-tsparticles/vue3` (React/Angular in arrivo).",
  "type": "module",
  "main": "./dist/vue3.cjs",
  "module": "./dist/vue3.js",
  "types": "./dist/vue3.d.ts",
  "exports": {
    "./vue3": {
      "types": "./dist/vue3.d.ts",
      "import": "./dist/vue3.js",
      "require": "./dist/vue3.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "keywords": [
    "vue",
    "vue3",
    "tsparticles",
    "particles",
    "web-audio",
    "canvas"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tsparticles/engine": "^3.0.0",
    "@tsparticles/vue3": "^3.0.0",
    "tsparticles": "^3.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/vue3": "^3.0.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "tsparticles": "^3.9.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.12"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "example:vue3": "npm run build && npm install --prefix examples/vue3-minimal && npm run dev --prefix examples/vue3-minimal"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umbert0dev/dynamic-tsparticles.git"
  },
  "bugs": {
    "url": "https://github.com/umbert0dev/dynamic-tsparticles/issues"
  },
  "homepage": "https://github.com/umbert0dev/dynamic-tsparticles#readme"
}
