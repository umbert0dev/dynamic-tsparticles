{
  "name": "dynamic-tsparticles-vue3",
  "version": "0.2.1",
  "description": "tsParticles + Vue 3: dynamic speed (slider/audio), custom mover, AudioAnalyzer.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "keywords": [
    "vue",
    "vue3",
    "tsparticles",
    "particles",
    "web-audio",
    "canvas"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tsparticles/engine": "^3.0.0",
    "@tsparticles/vue3": "^3.0.0",
    "tsparticles": "^3.0.0",
    "vue": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umbert0dev/dynamic-tsparticles.git",
    "directory": "packages/vue3"
  },
  "bugs": {
    "url": "https://github.com/umbert0dev/dynamic-tsparticles/issues"
  },
  "homepage": "https://github.com/umbert0dev/dynamic-tsparticles#readme",
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  }
}
